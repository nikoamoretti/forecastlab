# ForecastLab local environment
# Copy to .env if you want file-based defaults. The Settings UI is preferred.
# API keys must never be committed.

FORECASTLAB_ENV=local
FORECASTLAB_API_HOST=127.0.0.1
FORECASTLAB_API_PORT=8765
FORECASTLAB_WEB_PORT=3000
FORECASTLAB_DATABASE_URL=sqlite:///./data/forecastlab.db
FORECASTLAB_DATA_DIR=./data
FORECASTLAB_ALLOW_LOCAL_FIXTURES=1
FORECASTLAB_EMBEDDED_WORKER=0
FORECASTLAB_LOG_LEVEL=INFO

# Optional live providers. Leave empty for mock/demo mode.
# OpenRouter: FORECASTLAB_MODEL_PROVIDER=openrouter, FORECASTLAB_MODEL_NAME=openai/gpt-5-mini,
# your OpenRouter key in FORECASTLAB_MODEL_API_KEY; the base URL defaults to https://openrouter.ai/api/v1.
FORECASTLAB_MODEL_PROVIDER=mock
FORECASTLAB_MODEL_BASE_URL=
FORECASTLAB_MODEL_NAME=mock-forecast-v1
FORECASTLAB_MODEL_API_KEY=
FORECASTLAB_MODEL_TIMEOUT_SECONDS=60
FORECASTLAB_MAX_COST_USD=5.00

FORECASTLAB_SEARCH_PROVIDER=mock
FORECASTLAB_SEARCH_API_KEY=

# Cloud only: set these in Vercel, never in committed files.
# Neon supplies DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (migrations).
# Private Blob supplies BLOB_READ_WRITE_TOKEN. Keep all three production-only.
# FORECASTLAB_ENV=production
# FORECASTLAB_WEB_ORIGIN=https://forecastlab-web.vercel.app
# FORECASTLAB_OWNER_GITHUB_ID=<numeric GitHub user ID>
# FORECASTLAB_GITHUB_CLIENT_ID=
# FORECASTLAB_GITHUB_CLIENT_SECRET=
# FORECASTLAB_SESSION_SECRET=
# FORECASTLAB_INTERNAL_SECRET=
# CRON_SECRET=
# FORECASTLAB_ALLOW_LOCAL_FIXTURES=false
# FORECASTLAB_FRED_API_KEY=
# Web project only: FORECASTLAB_API_ORIGIN=https://forecastlab-api.vercel.app
# Web project also needs the same FORECASTLAB_INTERNAL_SECRET, production-only.
